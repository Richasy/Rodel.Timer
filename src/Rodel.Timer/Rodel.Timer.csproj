<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>Working Timer</AssemblyTitle>
    <Product>Working Timer</Product>
    <Company>Richasy</Company>
    <Description>A focused, minimal Windows count-up timer.</Description>
    <PublishAot>true</PublishAot>
    <SproutPackageFormat>Msix</SproutPackageFormat>
    <SproutAppxVersion>2.0.0.0</SproutAppxVersion>
    <SproutDefaultLanguage>en-US</SproutDefaultLanguage>
    <SproutLocalizationNamespace>Rodel.Timer</SproutLocalizationNamespace>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Sprout" />
    <PackageReference Include="Sprout.Backend.D2D" />
    <PackageReference Include="Sprout.FluentIcon" />
    <PackageReference Include="Sprout.Packaging" />
    <PackageReference Include="Sprout.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rodel.Timer.Core\Rodel.Timer.Core.csproj" />
    <ProjectReference Include="..\Rodel.Timer.Presentation\Rodel.Timer.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the app logo into the assembly so the About icon resolves identically whether the app runs packaged
         (MSIX) or as the loose published exe (the DevTools capture host) — the MSIX Assets are not copied to the
         loose publish output. -->
    <EmbeddedResource Include="Assets\AppLogo.png">
      <LogicalName>Rodel.Timer.AppLogo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
